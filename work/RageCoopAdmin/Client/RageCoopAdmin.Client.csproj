<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>RageCoopAdmin.Client</AssemblyName>
    <PublicRelease Condition="'$(PublicRelease)' == ''">true</PublicRelease>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublicRelease)' == 'true'">
    <EmbeddedResource Include="Assets/PublicVehicleCatalog.json" LogicalName="RageCoopAdmin.Client.AddonVehicles.json" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/EngineContract.cs" Link="Shared/EngineContract.cs" />
    <Compile Include="../Shared/ProductInfo.cs" Link="Shared/ProductInfo.cs" />
    <Compile Include="../Shared/Finite.cs" Link="Shared/Finite.cs" />
    <Compile Include="../Shared/Garage.cs" Link="Shared/Garage.cs" />
    <Compile Include="../Shared/AtomicFile.cs" Link="Shared/AtomicFile.cs" />
    <Compile Include="../Shared/VehicleAppearance.cs" Link="Shared/VehicleAppearance.cs" />
    <Compile Include="../Shared/WorldOptions.cs" Link="Shared/WorldOptions.cs" />
    <Compile Include="../Shared/WorldStateProtocol.cs" Link="Shared/WorldStateProtocol.cs" />
    <Compile Include="../Shared/GhostTrafficProtocol.cs" Link="Shared/GhostTrafficProtocol.cs" />
    <Compile Include="../Shared/SpecialPlaceProtocol.cs" Link="Shared/SpecialPlaceProtocol.cs" />
    <Compile Include="../Shared/EngineTransportGuard.cs" Link="Shared/EngineTransportGuard.cs" />
    <Compile Include="../Shared/EngineCodecGuard.cs" Link="Shared/EngineCodecGuard.cs" />
    <Compile Include="../Shared/EngineFragmentGuard.cs" Link="Shared/EngineFragmentGuard.cs" />
    <Compile Include="../Shared/EngineLoggerGuard.cs" Link="Shared/EngineLoggerGuard.cs" />
    <Compile Include="../Shared/EngineWorkerGuard.cs" Link="Shared/EngineWorkerGuard.cs" />
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="RageCoop.Client">
      <HintPath>$(RageCoopClientDir)/RageCoop.Client.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Lidgren.Network">
      <HintPath>$(RageCoopClientDir)/Lidgren.Network.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RageCoop.Core">
      <HintPath>$(RageCoopServerDir)/RageCoop.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ScriptHookVDotNet3">
      <HintPath>$(RageCoopServerDir)/ScriptHookVDotNet3.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LemonUI.SHVDN3">
      <HintPath>$(LemonUiDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <!-- A version derived from the compiled sources and embedded files: a changed
       build gets its own assembly identity, so EarlyClient's resource loader loads
       it on reconnect instead of reusing the copy already in this GTA process.
       The same sources always give the same version. -->
  <Target Name="StampSourceVersion" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo" Condition="'$(DesignTimeBuild)' != 'true'">
    <GetFileHash Files="@(Compile);@(EmbeddedResource)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_SourceVersionFile" />
    </GetFileHash>
    <Hash ItemsToHash="@(_SourceVersionFile->'%(FileHash)')">
      <Output TaskParameter="HashResult" PropertyName="_SourceVersionDigest" />
    </Hash>
    <PropertyGroup>
      <_SourceVersionBuild>$([MSBuild]::Modulo($([System.Convert]::ToInt32($(_SourceVersionDigest.Substring(0, 4)), 16)), 65000))</_SourceVersionBuild>
      <_SourceVersionRevision>$([MSBuild]::Modulo($([System.Convert]::ToInt32($(_SourceVersionDigest.Substring(4, 4)), 16)), 65000))</_SourceVersionRevision>
      <AssemblyVersion>1.0.$(_SourceVersionBuild).$(_SourceVersionRevision)</AssemblyVersion>
      <FileVersion>$(AssemblyVersion)</FileVersion>
    </PropertyGroup>
  </Target>
  <Target Name="ValidateBuildProfile" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PublicRelease)' != 'true' And '$(PublicRelease)' != 'false'" Text="PublicRelease must be true or false." />
  </Target>
  <Target Name="ValidateRageCoopReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RageCoopServerDir)' == '' Or !Exists('$(RageCoopServerDir)/RageCoop.Core.dll') Or !Exists('$(RageCoopServerDir)/ScriptHookVDotNet3.dll')" Text="Set RageCoopServerDir in References.props to the compatible RageCoop server directory." />
    <Error Condition="'$(RageCoopClientDir)' == '' Or !Exists('$(RageCoopClientDir)/RageCoop.Client.dll')" Text="Set RageCoopClientDir in References.props to the compatible installed client directory." />
    <Error Condition="'$(LemonUiDll)' == '' Or !Exists('$(LemonUiDll)')" Text="Set LemonUiDll in References.props to the compatible LemonUI.SHVDN3.dll file." />
  </Target>
</Project>
