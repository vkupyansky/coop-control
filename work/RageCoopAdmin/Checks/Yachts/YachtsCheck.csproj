<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
    <Compile Include="../../Shared/Yacht.cs" Link="Yacht.cs" />
    <Compile Include="../../Client/Yachts.cs" Link="Yachts.cs" />
    <Compile Include="../../Client/YachtLooks.cs" Link="YachtLooks.cs" />
    <Compile Include="../../Client/YachtRuntime.cs" Link="YachtRuntime.cs" />
    <Compile Include="../../Client/LocalPeds.cs" Link="LocalPeds.cs" />
    <Reference Include="ScriptHookVDotNet3"><HintPath>$(RageCoopServerDir)/ScriptHookVDotNet3.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
