<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>InstallerCheck</AssemblyName>
    <StartupObject>InstallerCheck.CheckProgram</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Compile Include="../../Shared/ProductInfo.cs" Link="Installer/ProductInfo.cs" />
    <Compile Include="../../Installer/*.cs" Exclude="../../Installer/obj/**;../../Installer/bin/**" LinkBase="Installer" />
  </ItemGroup>
</Project>
