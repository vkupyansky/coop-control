<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="../../Shared/EngineContract.cs" Link="EngineContract.cs" />
    <Compile Include="../../Shared/Finite.cs" Link="Finite.cs" />
    <Compile Include="../../Client/GhostTrafficController.cs" Link="GhostTrafficController.cs" />
    <Compile Include="../../Client/GhostTrafficRuntime.cs" Link="GhostTrafficRuntime.cs" />
    <Compile Include="../../Client/RuntimeEntityLookup.cs" Link="RuntimeEntityLookup.cs" />
    <Compile Include="../../Client/TrafficHandover.cs" Link="TrafficHandover.cs" />
    <Compile Include="../../Shared/GhostTrafficProtocol.cs" Link="GhostTrafficProtocol.cs" />
    <Compile Include="../../Shared/WorldStateProtocol.cs" Link="WorldStateProtocol.cs" />
    <Compile Include="../../Shared/WorldOptions.cs" Link="WorldOptions.cs" />
    <Compile Include="../../Shared/EngineCodecGuard.cs" Link="EngineCodecGuard.cs" />
    <Reference Include="RageCoop.Client"><HintPath>$(RageCoopClientDir)/RageCoop.Client.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="RageCoop.Core"><HintPath>$(RageCoopServerDir)/RageCoop.Core.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="ScriptHookVDotNet3"><HintPath>$(RageCoopServerDir)/ScriptHookVDotNet3.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Lidgren.Network"><HintPath>$(RageCoopClientDir)/Lidgren.Network.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
