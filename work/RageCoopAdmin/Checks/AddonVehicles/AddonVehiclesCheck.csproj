<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PublicRelease Condition="'$(PublicRelease)' == ''">true</PublicRelease>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="MenuBoundary.cs" />
    <Compile Include="../../Client/AddonVehicleCatalog.cs" Link="AddonVehicleCatalog.cs" />
    <Compile Include="../../Client/VehicleSearch.cs" Link="VehicleSearch.cs" />
    <Compile Include="../../Client/AddonVehicleMenu.cs" Link="AddonVehicleMenu.cs" />
    <Compile Include="../../Client/VehicleMenuPresentation.cs" Link="VehicleMenuPresentation.cs" />
    <Compile Include="../../Client/VehicleFavoritesMenu.cs" Link="VehicleFavoritesMenu.cs" />
    <Compile Include="../../Client/GarageClient.cs" Link="GarageClient.cs" />
    <Compile Include="../../Shared/Garage.cs" Link="Garage.cs" />
    <Compile Include="../../Shared/VehicleAppearance.cs" Link="VehicleAppearance.cs" />
    <Compile Include="../../Client/UiLanguage.cs" Link="UiLanguage.cs" />
    <Compile Include="../../Client/UiText.cs" Link="UiText.cs" />
    <Compile Include="../../Client/UiMenu.cs" Link="UiMenu.cs" />
    <EmbeddedResource Include="../../Client/Assets/MenuEnglish.resx" LogicalName="RageCoopAdmin.Client.Assets.MenuEnglish.resources" />
    <EmbeddedResource Include="../../Client/Assets/PublicVehicleCatalog.json" LogicalName="RageCoopAdmin.Client.AddonVehicles.json" Condition="'$(PublicRelease)' == 'true'" />
  </ItemGroup>
  <Target Name="ValidateBuildProfile" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(PublicRelease)' != 'true' And '$(PublicRelease)' != 'false'" Text="PublicRelease must be true or false." />
  </Target>
</Project>
